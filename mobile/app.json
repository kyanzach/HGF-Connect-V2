{
  "expo": {
    "name": "HGF Connect",
    "slug": "hgf-connect",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hgfconnect",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2d3d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.houseofgrace.connect",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "HGF Connect requires access to your camera so you can take photos for your member profile and community posts.",
        "NSPhotoLibraryUsageDescription": "HGF Connect requires access to your photo library so you can select photos for your member profile, testimonies, and StewardShop listings."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0f2d3d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "ph.houseofgrace.connect",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "HGF Connect requires access to your photo library so you can select photos for your member profile, testimonies, and StewardShop listings.",
          "cameraPermission": "HGF Connect requires access to your camera so you can take photos for your member profile and community posts.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4EB1CB"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
